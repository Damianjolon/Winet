generator client {
id BigInt @id @default(autoincrement())
numero String? @unique
fecha DateTime @default(now())
cliente_id BigInt
subtotal Decimal @default(0) @db.Decimal(12,2)
descuento_total Decimal @default(0) @db.Decimal(12,2)
impuesto_total Decimal @default(0) @db.Decimal(12,2)
total_neto Decimal @default(0) @db.Decimal(12,2)
estado EstadoRecibo @default(BORRADOR)
notas String?
cliente Cliente @relation(fields: [cliente_id], references: [id])
items ReciboItem[]
}


enum EstadoRecibo {
BORRADOR
EMITIDO
ANULADO
}


model ReciboItem {
id BigInt @id @default(autoincrement())
recibo_id BigInt
tipo_item TipoItem
servicio_id BigInt?
producto_id BigInt?
descripcion String
cantidad Decimal @db.Decimal(14,3)
precio_unitario Decimal @db.Decimal(12,2)
descuento_pct Decimal @default(0) @db.Decimal(5,2)
impuesto_pct Decimal @default(0) @db.Decimal(5,2)
total_linea Decimal @db.Decimal(12,2)
recibo Recibo @relation(fields: [recibo_id], references: [id])
servicio Servicio? @relation(fields: [servicio_id], references: [id])
producto Producto? @relation(fields: [producto_id], references: [id])
}


enum TipoItem { SERVICIO PRODUCTO }


model InventarioMovimiento {
id BigInt @id @default(autoincrement())
producto_id BigInt
fecha DateTime @default(now())
tipo TipoMov
cantidad Decimal @db.Decimal(14,3)
costo_unitario Decimal @default(0) @db.Decimal(12,2)
referencia String?
referencia_id BigInt?
comentario String?
producto Producto @relation(fields: [producto_id], references: [id])
}


enum TipoMov { IN OUT ADJ }


model Secuencia {
nombre String @id
valor BigInt
}
