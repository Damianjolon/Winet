{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install && npm --prefix backend install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/user-app",
  "rewrites": [
    { "source": "/((?!api/)[^.]+)", "destination": "/index.html" }
  ]
}
